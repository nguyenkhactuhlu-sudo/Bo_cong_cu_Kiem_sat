# Build artifacts
build/
dist/
__pycache__/

# Spec files in build/dist (build artifacts)
build/*.spec
dist/*.spec

# Executable files (too large for git)
*.exe

# Zip archives in build/dist (build artifacts, too large for git)
build/*.zip
dist/*.zip

# Python cache
*.pyc
*.pyo

# API Keys (chứa thông tin nhạy cảm)
Tool/PdfToMd/API keys.txt

# Công cụ đã rút khỏi hệ thống nhưng giữ cục bộ để có thể dùng lại sau này
Tool/_local_archive/

# Runtime/user files created by the portable OCR tool
Tool/OCR_PDF_Tool/OCR_PDF_Tool/uploads/*
Tool/OCR_PDF_Tool/OCR_PDF_Tool/outputs/*
Tool/OCR_PDF_Tool/OCR_PDF_Tool/temp_images/*
Tool/OCR_PDF_Tool/source/uploads/*
Tool/OCR_PDF_Tool/source/outputs/*
Tool/OCR_PDF_Tool/source/temp_images/*
